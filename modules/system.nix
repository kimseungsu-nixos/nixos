{ pkgs, ... }:

{
  # Bootloader. Keep only the latest generations in the boot menu; older ones
  # are removed from /boot on the next switch (and from the store by nix.gc).
  boot.loader.systemd-boot = {
    enable = true;
    configurationLimit = 5;
  };
  boot.loader.efi.canTouchEfiVariables = true;

  # Wine/Proton use /dev/ntsync (kernel 6.14+) for faster thread synchronisation.
  # uinput is needed by ds-controller to create virtual keyboard/pointer devices.
  boot.kernelModules = [ "ntsync" "uinput" ];

  # Common removable-drive formats. vfat covers FAT32 and is already used by
  # the EFI partition; enable NTFS and exFAT for external storage as well.
  boot.supportedFilesystems = [ "ntfs" "vfat" "exfat" ];

  # Intel laptop panel: PSR2 selective fetch fails ("Selective fetch area calculation
  # failed in pipe A" in dmesg) and causes black flicker when only part of the screen
  # updates (e.g. rotating a 3D view). Panel Self Refresh off fixes it.
  # quiet/splash/loglevel: no kernel or initrd text between the boot menu and the desktop.
  # Keep the supported Iris Xe and Arc devices on i915; do not force-probe them with xe.
  boot.kernelParams = [ "i915.enable_psr=0" "xe.force_probe=!*" "consoleblank=0" "quiet" "splash" "loglevel=3" "udev.log_level=3" "rd.systemd.show_status=false"
  ];
  boot.consoleLogLevel = 0;
  boot.initrd.verbose = false;

  # Graphical boot splash (hands over to SDDM/autologin without a text console).
  boot.plymouth = {
    enable = true;
    theme = "catppuccin-mocha";
    themePackages = [ (pkgs.catppuccin-plymouth.override { variant = "mocha"; }) ];
  };

  networking.hostName = "linux";

  # Shutdown used to wait for the full stop timeout on "User Manager for UID 1000".
  # user@.service ships its own long TimeoutStopSec, so it is overridden separately
  # from the global default. Stuck user processes (e.g. Wine) get killed after 15s.
  systemd.settings.Manager.DefaultTimeoutStopSec = "15s";
  systemd.services."user@" = {
    overrideStrategy = "asDropin";
    serviceConfig.TimeoutStopSec = "15s";
  };
  networking.networkmanager.enable = true;
  # Lan Mouse shares keyboard and pointer input with the paired Windows machine.
  networking.firewall.allowedUDPPorts = [ 4242 ];
  # Keep Wi-Fi at full power on every NetworkManager connection.
  networking.networkmanager.wifi.powersave = false;
  # NetworkManager ranks Ethernet (metric 100) above Wi-Fi (600). Both get the same metric here, so
  # neither takes the default route from the other just because of its type.
  networking.networkmanager.settings."connection-ethernet" = {
    "match-device" = "type:ethernet";
    "ipv4.route-metric" = 600;
    "ipv6.route-metric" = 600;
  };

  time.timeZone = "Asia/Seoul";

  i18n.defaultLocale = "en_US.UTF-8";
  # Korean locale for apps that ask for it (Hancom, previously generated by the hnc module).
  i18n.extraLocales = [ "ko_KR.UTF-8/UTF-8" ];
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_US.UTF-8";
    LC_IDENTIFICATION = "en_US.UTF-8";
    LC_MEASUREMENT = "en_US.UTF-8";
    LC_MONETARY = "en_US.UTF-8";
    LC_NAME = "en_US.UTF-8";
    LC_NUMERIC = "en_US.UTF-8";
    LC_PAPER = "en_US.UTF-8";
    LC_TELEPHONE = "en_US.UTF-8";
    LC_TIME = "en_US.UTF-8";
  };

  users.users."linux" = {
    isNormalUser = true;
    description = "Linux";
    # "input" 그룹이 있어야 DS가 키보드/조이스틱을 읽는다.
    # libinput은 evdev 장치를 O_RDWR로 열기 때문에 그룹 쓰기 권한이 필수다.
    extraGroups = [ "networkmanager" "wheel" "input" ];
  };

  # --- SC-IPK DriverStation ---
  # DS(Avalonia)는 네이티브 백엔드에서 libinput으로 키보드를 직접 연다.
  # libinput은 O_RDWR로 열어야 하므로 /dev/input/event* 가 0660(input) 이어야 한다.
  # 기본값(0644)으로는 open 이 EACCES 로 거부되어 DS가
  # "Native backend initialization failed with status NoKeyboard" 로 죽고,
  # AT-SPI 접근성 트리를 노출하지 않아 대시보드/로봇 API 연동이 통째로 막힌다.
  #
  # NixOS는 /etc 가 읽기 전용이라 rules 파일을 직접 복사할 수 없다.
  # services.udev.packages 로 규칙 파일을 패키징해 전달한다.
  services.udev.packages = [
    (pkgs.writeTextFile {
      name = "sc-ds-udev-rules";
      destination = "/etc/udev/rules.d/99-sc-ds.rules";
      text = builtins.readFile ../files/99-sc-ds.rules;
    })
  ];
  # uinput(가상 입력 장치) 모듈. ds-controller 가 가상 키보드/포인터를 만든다.
  # (위 boot.kernelModules 목록에 이미 포함)

  services.openssh.enable = true;

  nixpkgs.config.allowUnfree = true;

  nix.settings = {
    # One build at a time, with at most four parallel compiler jobs per build.
    max-jobs = 1;
    cores = 4;
    extra-substituters = [ "https://noctalia.cachix.org" "https://ros.cachix.org" ];
    extra-trusted-public-keys = [
      "noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4="
      "ros.cachix.org-1:dSyZxI8geDCJrwgvCOHDoAfOm5sV1wCPjBkKL+38Rvo="
    ];
  };

  # Enforce the CPU budget even when a build tool ignores NIX_BUILD_CORES.
  systemd.services.nix-daemon.serviceConfig = {
    CPUQuota = "400%";
    CPUWeight = 25;
    Nice = 10;
  };

  # Automatic cleanup of old build results: every week, delete generations and
  # store paths older than 7 days (the running generation is always kept),
  # and hard-link identical files in the store.
  nix.gc = {
    automatic = true;
    dates = "weekly";
    persistent = true;
    options = "--delete-older-than 7d";
  };
  nix.optimise.automatic = true;

  # Do not change after install; see `man configuration.nix`.
  system.stateVersion = "26.05";
}
