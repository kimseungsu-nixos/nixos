+bool NetworkTab::syncHotspot() {
+  const bool active = hotspotRunning();
+  m_hotspotActive = active;
+  if (!active) {
+    m_hotspotPassword.clear();
+  }
+  if (m_hotspotCard == nullptr) {
+    return false;
+  }
+
+  const bool available = networkAvailable();
+  const bool pending = m_hotspotSaving || m_hotspotRequested.has_value();
+  const auto band = m_hotspotBand->selectedIndex();
+  m_hotspotToggle->setChecked(m_hotspotRequested.value_or(active));
+  m_hotspotToggle->setEnabled(!pending && (active || (available && m_network->state().wirelessEnabled)));
+  m_hotspotName->setEnabled(!pending);
+  m_hotspotPassphrase->setEnabled(!pending);
+  m_hotspotBand->setEnabled(!pending);
+  m_hotspotChannel24->setEnabled(!pending && (band == 1U || band == 3U));
+  m_hotspotChannel5->setEnabled(!pending && (band == 2U || band == 3U));
+  m_hotspotUplink->setEnabled(!pending);
+  m_hotspotSaveButton->setEnabled(!pending);
+  m_hotspotRevealButton->setVisible(active);
+  m_hotspotRevealButton->setGlyph(m_hotspotPassword.empty() ? "eye" : "eye-off");
+  std::string detail;
+  if (active) {
+    std::ifstream status(kHotspotStatus);
+    std::string channels;
+    if (!std::getline(status, detail)) {
+      detail = "NixOS Hotspot";
+    }
+    if (std::getline(status, channels) && !channels.empty()) {
+      detail += "  •  " + channels;
+    }
+    if (!m_hotspotPassword.empty()) {
+      detail += '\n' + m_hotspotPassword;
+    }
+  }
+  const bool changed = m_hotspotCard->visible() != available || m_hotspotForm->visible() != m_hotspotEditing ||
+                       m_hotspotDetail->visible() != active || m_hotspotDetail->text() != detail;
+  m_hotspotCard->setVisible(available);
+  m_hotspotForm->setVisible(m_hotspotEditing);
+  m_hotspotDetail->setVisible(active);
+  m_hotspotDetail->setText(detail);
+  return changed;
+}
+
+void NetworkTab::loadHotspotSettings() {
+  std::array<std::string, 6> values{"auto", "0", "0", "NixOS Hotspot", "", "auto"};
+  std::ifstream settings(FileUtils::configDir() + "/hotspot.conf");
+  std::string line;
+  for (auto& value : values) {
+    if (std::getline(settings, line)) {
+      value = line;
+    }
+  }
+  m_hotspotBand->setSelectedIndexSilently(hotspotOption(kHotspotBands, values[0]));
+  m_hotspotChannel24->setSelectedIndexSilently(hotspotOption(kChannels24, values[1]));
+  m_hotspotChannel5->setSelectedIndexSilently(hotspotOption(kChannels5, values[2]));
+  m_hotspotName->setValue(values[3]);
+  m_hotspotPassphrase->setValue(values[4]);
+
+  const auto uplinks = process::runSyncWithTimeout({"noctalia-hotspot-service", "uplinks"}, std::chrono::milliseconds(500));
+  m_hotspotUplinkIds = {"auto"};
+  std::vector<std::string> labels{i18n::tr("control-center.network.hotspot-auto")};
+  std::istringstream rows(uplinks.out);
+  while (std::getline(rows, line)) {
+    const auto separator = line.find('\t');
+    if (separator == std::string::npos || separator == 0U) {
+      continue;
+    }
+    const std::string id = line.substr(0, separator);
+    const std::string name = line.substr(separator + 1);
+    m_hotspotUplinkIds.push_back(id);
+    labels.push_back(name.empty() || name == id ? id : name + " (" + id + ")");
+  }
+  const std::string& selected = values[5];
+  if (!selected.empty() && std::ranges::find(m_hotspotUplinkIds, selected) == m_hotspotUplinkIds.end()) {
+    m_hotspotUplinkIds.push_back(selected);
+    labels.push_back(i18n::tr("control-center.network.hotspot-uplink-offline", "device", selected));
+  }
+  m_hotspotUplink->setOptions(std::move(labels));
+  m_hotspotUplink->setSelectedIndexSilently(hotspotOption(m_hotspotUplinkIds, selected));
+}
+
+void NetworkTab::saveHotspotSettings() {
+  if (m_hotspotSaving || m_hotspotRequested) {
+    return;
+  }
+  std::string settings = optionAt(kHotspotBands, m_hotspotBand->selectedIndex());
+  settings += '\n';
+  settings += optionAt(kChannels24, m_hotspotChannel24->selectedIndex());
+  settings += '\n';
+  settings += optionAt(kChannels5, m_hotspotChannel5->selectedIndex());
+  settings += '\n' + m_hotspotName->value() + '\n' + m_hotspotPassphrase->value() + '\n';
+  settings += optionAt(m_hotspotUplinkIds, m_hotspotUplink->selectedIndex()) + '\n';
+  m_hotspotSaving = true;
+  runHotspotCommand({"noctalia-hotspot-service", "save"}, std::move(settings));
+}
+
+void NetworkTab::requestHotspot(bool enabled) {
+  if (m_hotspotRequested || m_hotspotSaving) {
+    return;
+  }
+  m_hotspotRequested = enabled;
+  runHotspotCommand({"systemctl", "--no-ask-password", enabled ? "start" : "stop", kHotspotUnit});
+}
+
+void NetworkTab::runHotspotCommand(std::vector<std::string> command, std::optional<std::string> input) {
+  PanelManager::instance().requestUpdateOnly();
+
+  const std::weak_ptr<int> alive = m_hotspotLifetime;
+  const bool saving = m_hotspotSaving;
+  const bool started = process::runAsync(
+      command,
+      process::RunCallbacks{
+          .onExit = [this, alive, saving](process::RunResult run) {
+            std::string reason;
+            if (!run && saving) {
+              reason = StringUtils::trim(run.err);
+              if (const auto lastLine = reason.rfind('\n'); lastLine != std::string::npos) {
+                reason.erase(0, lastLine + 1);
+              }
+            } else if (!run) {
+              reason = StringUtils::trim(process::runSyncWithTimeout(
+                  {"systemctl", "show", "-p", "StatusText", "--value", kHotspotUnit}, std::chrono::seconds(2)
+              ).out);
+            }
+            DeferredCall::callLater([this, alive, success = static_cast<bool>(run), reason = std::move(reason)] {
+              if (alive.expired()) {
+                return;
+              }
+              m_hotspotRequested.reset();
+              if (m_hotspotSaving && success) {
+                m_hotspotEditing = false;
+                m_hotspotPassword.clear();
+              }
+              m_hotspotSaving = false;
+              if (!success) {
+                notify::error(i18n::tr("control-center.network.hotspot"),
+                              i18n::tr("control-center.network.hotspot-failed"), reason);
+              }
+              PanelManager::instance().refresh();
+            });
+          },
+      },
+      process::RunOptions{.timeout = std::chrono::seconds(90), .maxOutputBytes = 4096, .stdinData = std::move(input)}
+  );
+  if (!started) {
+    m_hotspotRequested.reset();
+    m_hotspotSaving = false;
+    notify::error(i18n::tr("control-center.network.hotspot"), i18n::tr("control-center.network.hotspot-failed"), {});
+  }
+}
