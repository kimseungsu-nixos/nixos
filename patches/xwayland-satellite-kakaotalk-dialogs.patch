+        // Changing XRandR's primary output broadcasts a Windows display change.
+        // KakaoTalk responds by unmapping its main window during a monitor move.
+        // Keep the primary output stable while focusing/moving KakaoTalk windows.
+        // The invisible tray container can receive fallback focus when a chat closes;
+        // it must not switch the primary output and hide the main window either.
+        let cookie = self.connection.send_request(&x::GetProperty {
+            window,
+            delete: false,
+            property: x::ATOM_WM_CLASS,
+            r#type: x::ATOM_STRING,
+            long_offset: 0,
+            long_length: 256,
+        });
+        if let Ok(reply) = self.connection.wait_for_reply(cookie) {
