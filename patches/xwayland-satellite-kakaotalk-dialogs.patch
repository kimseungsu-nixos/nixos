diff --git a/src/xstate/tests.rs b/src/xstate/tests.rs
index d59099c..4a5e5c5 100644
--- a/src/xstate/tests.rs
+++ b/src/xstate/tests.rs
@@ -113,6 +113,28 @@ mod window_role_heuristics {
         assert_eq!(win.guess_window_role(&win_types), WindowRole::Toplevel);
     }
 
+    #[test]
+    fn kakaotalk_dialog_and_tooltip() {
+        let win_types = WindowTypes::new();
+        let mut win = WindowRoleHeuristics {
+            window_types: vec![win_types.dialog],
+            has_transient_for: true,
+            motif_wm_hints: Some(motif::Hints::from([3_u32, 0x24, 0, 0, 0].as_slice())),
+            wm_normal_hints: Some(WmNormalHints::new().min_size(375, 750).max_size(375, 750).into()),
+            wm_class: Some("kakaotalk.exe".into()),
+            ..Default::default()
+        };
+        assert_eq!(win.guess_window_role(&win_types), WindowRole::Toplevel);
+        win.override_redirect = true;
+        assert_eq!(win.guess_window_role(&win_types), WindowRole::Popup);
+        win.override_redirect = false;
+        // KakaoTalkShadowWnd has only Move, and must remain a popup.
+        win.motif_wm_hints = Some(motif::Hints::from([3_u32, 4, 0, 0, 0].as_slice()));
+        assert_eq!(win.guess_window_role(&win_types), WindowRole::Popup);
+        win.motif_wm_hints = Some(motif::Hints::from([3_u32, 0, 0, 0, 0].as_slice()));
+        assert_eq!(win.guess_window_role(&win_types), WindowRole::Popup);
+    }
+
     // https://github.com/Supreeeme/xwayland-satellite/issues/110
     // Popup because _MOTIF_WM_HINTS indicates user cannot interact which the window
     #[test]
